{
  "version": 2,
  "builds": [
    { "src": "index.html",     "use": "@vercel/static" },
    { "src": "api/webhook.py", "use": "@vercel/python"  },
    { "src": "api/lead.py",    "use": "@vercel/python"  }
  ],
  "routes": [
    { "src": "/api/webhook", "dest": "api/webhook.py" },
    { "src": "/api/lead",    "dest": "api/lead.py"    },
    { "src": "/(.*)",        "dest": "/index.html"    }
  ]
}
